# Boot into an initramfs without module loading: keep built in
# the drivers the OnePlus 15 needs to reach init, bring up the
# panel, enumerate UFS storage and provide a USB CDC-ACM console.
CONFIG_DRM=y
CONFIG_DRM_MSM=y
CONFIG_DRM_PANEL_ONEPLUS15_A0020=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_DRM_DISPLAY_HELPER=y
CONFIG_QCOM_LLCC=y
# CONFIG_QCOM_OCMEM is not set
CONFIG_CLK_KAANAPALI_DISPCC=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_USB_CONFIGFS=y
